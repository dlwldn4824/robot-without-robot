<mujoco model="embedded_arena">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>
  <visual>
    <global offwidth="900" offheight="900"/>
    <quality shadowsize="1024"/>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.35 0.35 0.35"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.72 0.78 0.86" rgb2="0.97 0.98 1.0" width="128" height="128"/>
    <texture name="check" type="2d" builtin="checker" width="400" height="400"
             rgb1="0.94 0.93 0.88" rgb2="0.84 0.82 0.76"/>
    <material name="check" texture="check" texrepeat="14 14" reflectance="0.08"/>
    <material name="wall" rgba="0.50 0.50 0.56 1"/>
    <material name="obs"  rgba="0.80 0.55 0.25 1"/>
    <material name="goal" rgba="0.33 0.88 0.40 0.95"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8" castshadow="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="check" friction="1.1 0.005 0.0001"/>

    <geom name="wall_n" type="box" pos=" 0  3.0 0.22" size="3.1 0.1 0.22" material="wall"/>
    <geom name="wall_s" type="box" pos=" 0 -3.0 0.22" size="3.1 0.1 0.22" material="wall"/>
    <geom name="wall_e" type="box" pos=" 3.0 0   0.22" size="0.1 3.1 0.22" material="wall"/>
    <geom name="wall_w" type="box" pos="-3.0 0   0.22" size="0.1 3.1 0.22" material="wall"/>

    <!-- 장애물 -->
    <geom name="obs1" type="cylinder" pos=" 0.9  0.7 0.22" size="0.22 0.22" material="obs"/>
    <geom name="obs2" type="cylinder" pos="-1.0  1.5 0.22" size="0.20 0.22" material="obs"/>
    <geom name="obs3" type="cylinder" pos=" 0.1 -1.5 0.22" size="0.24 0.22" material="obs"/>
    <geom name="obs4" type="box"      pos="-1.7 -0.4 0.22" size="0.08 0.70 0.22" material="wall"/>
    <geom name="obs5" type="box"      pos=" 1.6  1.8 0.22" size="0.70 0.08 0.22" material="wall"/>

    <!-- 목표 (초록 실린더) -->
    <geom name="GOAL" type="cylinder" pos="2.2 -1.9 0.18" size="0.34 0.18" material="goal"/>
  </worldbody>

  <include file="car.xml"/>
</mujoco>
