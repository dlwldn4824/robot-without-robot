<!-- W6 월드 (흰 배경판). 형상·마찰은 world.xml 과 같고 색만 다르다 -->
<mujoco model="w6_world_white">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="960" offheight="720"/>
    <quality shadowsize="1024"/>
    <headlight diffuse="0.80 0.80 0.82" ambient="0.52 0.53 0.56" specular="0.1 0.1 0.1"/>
    <rgba haze="1 1 1 1"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="flat" rgb1="1 1 1" rgb2="1 1 1" width="64" height="64"/>
    <material name="grid" rgba="0.985 0.988 1.0 1" reflectance="0.05"/>
    <material name="wall" rgba="0.88 0.90 0.94 1"/>
    <material name="obs"  rgba="0.13 0.42 0.92 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.55 0.55 0.57" castshadow="true"/>
    <light pos="3 3 4" dir="-0.5 -0.5 -1" diffuse="0.22 0.22 0.24"/>

    <geom name="floor" type="plane" size="4 4 0.1" material="grid"
          friction="1.2 0.005 0.0001"/>

    <!-- 외벽 (7 x 7 m 아레나) -->
    <geom name="wall_n" type="box" pos=" 0  3.5 0.25" size="3.6 0.1 0.25" material="wall"/>
    <geom name="wall_s" type="box" pos=" 0 -3.5 0.25" size="3.6 0.1 0.25" material="wall"/>
    <geom name="wall_e" type="box" pos=" 3.5 0   0.25" size="0.1 3.6 0.25" material="wall"/>
    <geom name="wall_w" type="box" pos="-3.5 0   0.25" size="0.1 3.6 0.25" material="wall"/>

    <!-- 장애물: 기둥 6개 + 가벽 2개 -->
    <geom name="obs1" type="cylinder" pos=" 1.4  0.9 0.25" size="0.25 0.25" material="obs"/>
    <geom name="obs2" type="cylinder" pos="-1.3  1.7 0.25" size="0.22 0.25" material="obs"/>
    <geom name="obs3" type="cylinder" pos=" 0.2 -1.6 0.25" size="0.28 0.25" material="obs"/>
    <geom name="obs4" type="cylinder" pos="-1.9 -1.1 0.25" size="0.24 0.25" material="obs"/>
    <geom name="obs5" type="cylinder" pos=" 2.3 -2.0 0.25" size="0.20 0.25" material="obs"/>
    <geom name="obs6" type="cylinder" pos="-0.6  2.7 0.25" size="0.22 0.25" material="obs"/>
    <geom name="wall_i1" type="box" pos=" 2.2  1.9 0.25" size="0.9 0.08 0.25" material="wall"/>
    <geom name="wall_i2" type="box" pos="-2.4  0.4 0.25" size="0.08 0.9 0.25" material="wall"/>
  </worldbody>

  <!-- 로봇 정의 (worldbody / actuator / sensor 섹션이 합쳐진다) -->
  <include file="robot.xml"/>
</mujoco>
